# Settings for the APT repository published to GitHub Pages.
#
# Edit these once, then `./packaging/build-apt-repo.sh` and the release
# workflow both pick them up.

# GitHub account or org that owns the repository.
REPO_OWNER="dharani123"

# Repository name. The Pages URL becomes:
#   https://${REPO_OWNER}.github.io/${REPO_NAME}
REPO_NAME="mama"

# Shown by `apt policy` and in the Release file.
REPO_ORIGIN="MAMA CLI"
REPO_LABEL="MAMA CLI"

# Suite and component. "stable" and "main" are conventional; users write
#   deb [...] https://.../ stable main
REPO_SUITE="stable"
REPO_COMPONENT="main"

# Architectures advertised in the Release file. The package itself is
# Architecture: all, but apt on an amd64 machine looks for binary-amd64, so
# the index is published under each of these as well as binary-all.
REPO_ARCHITECTURES="all amd64 arm64"

# The signing key. Locally this can be any key id or email in your keyring;
# in CI it is the key imported from the GPG_PRIVATE_KEY secret.
# Leave empty to use gpg's default key.
REPO_GPG_KEY=""

# Filename of the published public key. Keep the .asc extension: apt treats
# a .gpg file as binary (dearmored), and this one is ASCII-armoured.
REPO_KEY_FILE="mama.asc"
