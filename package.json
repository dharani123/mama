{
  "name": "mama-cli",
  "version": "1.0.0",
  "description": "నీ టెర్మినల్ మామా — your Telugu-speaking terminal buddy.",
  "keywords": ["cli", "telugu", "motivation", "fun", "terminal", "developer", "mama"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "mama": "dist/src/cli.js"
  },
  "files": ["dist/src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "build": "npm run gen:version && tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test dist/tests/",
    "mama": "npm run build && node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
